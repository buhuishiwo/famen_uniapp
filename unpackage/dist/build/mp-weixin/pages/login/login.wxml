<view class="page-root"><navigation-bar title="登录" back="{{true}}" color="white" background="linear-gradient(135deg, #1a2236 0%, #0d1526 100%);"></navigation-bar><scroll-view class="scroll-wrap" scroll-y="{{true}}"><view class="login-container"><view class="logo-section"><view class="logo-icon">⚙️</view><text class="logo-title">阀门报价系统</text><text class="logo-subtitle">VALVE QUOTATION SYSTEM</text></view><view class="form-card"><view class="form-header"><view class="header-line"></view><text class="header-title">用户登录</text></view><view class="form-body"><view class="input-group"><view class="input-label"><text class="label-icon">�</text><text class="label-text">用户名</text></view><view class="{{['input-wrapper',(usernameFocus)?'active':'']}}"><input class="input-field" placeholder="请输入用户名" placeholder-class="placeholder" data-event-opts="{{[['focus',[['e0',['$event']]]],['blur',[['e1',['$event']]]],['input',[['__set_model',['','username','$event',[]]]]]]}}" value="{{username}}" bindfocus="__e" bindblur="__e" bindinput="__e"/></view><block wx:if="{{errors.username}}"><text class="error-text">{{errors.username}}</text></block></view><view class="input-group"><view class="input-label"><text class="label-icon">🔒</text><text class="label-text">密码</text></view><view class="{{['input-wrapper',(passwordFocus)?'active':'']}}"><input class="input-field" type="password" placeholder="请输入密码" placeholder-class="placeholder" data-event-opts="{{[['focus',[['e2',['$event']]]],['blur',[['e3',['$event']]]],['input',[['__set_model',['','password','$event',[]]]]]]}}" value="{{password}}" bindfocus="__e" bindblur="__e" bindinput="__e"/></view><block wx:if="{{errors.password}}"><text class="error-text">{{errors.password}}</text></block></view><view class="remember-row"><view data-event-opts="{{[['tap',[['toggleRemember',['$event']]]]]}}" class="checkbox-wrapper" bindtap="__e"><view class="{{['checkbox',(rememberMe)?'checked':'']}}"><block wx:if="{{rememberMe}}"><text class="check-mark">✓</text></block></view><text class="checkbox-label">记住登录状态</text></view></view><button data-event-opts="{{[['tap',[['handleLogin',['$event']]]]]}}" class="{{['login-button',(isLoading)?'disabled':'']}}" bindtap="__e"><text class="button-text">{{isLoading?'登录中...':'登 录'}}</text></button></view></view><view class="footer-section"><text class="footer-text">如有疑问请联系系统管理员</text></view></view></scroll-view></view>