<view><navigation-bar title="{{currentProductSeries||'阀门选择'}}" back="{{true}}" color="white" background="linear-gradient(135deg, #a8a8ea 0%, #0070c0 100%);" data-event-opts="{{[['back',[['onBackToCategory',['$event']]]]]}}" data-com-type="wx" bindback="__e"></navigation-bar><scroll-view class="scroll-content" scroll-y="{{true}}"><view class="form-section"><view class="form-item"><text class="label">阀门型号</text><picker class="picker" mode="selector" range="{{valveTypes}}" range-key="name" data-event-opts="{{[['change',[['onSelectValve',['$event']]]]]}}" bindchange="__e"><view class="picker-text">{{selectedValve?selectedValve.name:'请选择阀门型号'}}</view></picker></view><view class="form-item"><text class="label">规格尺寸 (DN)</text><picker class="picker" mode="selector" range="{{specifications}}" range-key="name" data-event-opts="{{[['change',[['onSelectSpec',['$event']]]]]}}" bindchange="__e"><view class="picker-text">{{selectedSpec?selectedSpec.name:'请选择规格尺寸'}}</view></picker></view><view><text class="label">阀体材质</text><picker class="picker" mode="selector" range="{{valveBodyTypes}}" range-key="name" data-event-opts="{{[['change',[['onSelectValveBody',['$event']]]]]}}" bindchange="__e"><view class="picker-text">{{(SelectValveBody?SelectValveBody.name:'请选择阀体材质')+''}}</view></picker></view><view class="form-item"><text class="label">闸板类型</text><picker class="picker" mode="selector" range="{{gatePlateTypes}}" range-key="name" data-event-opts="{{[['change',[['onSelectGatePlate',['$event']]]]]}}" bindchange="__e"><view class="picker-text">{{(selectedGatePlate?selectedGatePlate.name:'请选择闸板类型')+''}}</view></picker></view><view class="form-item"><text class="label">阀杆材质</text><picker class="picker" mode="selector" range="{{rodMaterials}}" range-key="name" data-event-opts="{{[['change',[['onSelectRodMaterial',['$event']]]]]}}" bindchange="__e"><view class="picker-text">{{(selectedRodMaterial?selectedRodMaterial.name:'请选择阀杆材质')+''}}</view></picker></view><view class="form-item"><text class="label">产品类型</text><picker class="picker" mode="selector" range="{{productTypeOptions}}" data-event-opts="{{[['change',[['onSelectProductType',['$event']]]]]}}" bindchange="__e"><view class="picker-text">{{selectedProductType}}</view></picker></view><view class="form-item"><text class="label">数量</text><input class="input" type="number" placeholder="请输入数量" data-event-opts="{{[['input',[['onQuantityChange',['$event']]]]]}}" value="{{quantity}}" bindinput="__e"/></view><block wx:if="{{selectedValve&&selectedSpec&&selectedGatePlate&&selectedRodMaterial}}"><view class="price-preview"><text class="price-label">单价：</text><text class="price-value">{{"¥"+currentPrice}}</text></view></block></view><view class="button-group"><button data-event-opts="{{[['tap',[['onAddToQuote',['$event']]]]]}}" class="btn btn-primary" bindtap="__e">添加到报价表</button><block wx:if="{{$root.g0>0}}"><button data-event-opts="{{[['tap',[['onGenerateQuotation',['$event']]]]]}}" class="btn btn-success" bindtap="__e">生成报价表</button></block></view><block wx:if="{{$root.g1>0}}"><view class="quote-list"><view class="section-title">报价表列表</view><block wx:for="{{quoteItems}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="quote-item"><view class="item-header"><text class="item-name">{{item.valveName}}</text><text class="item-price">{{"¥"+item.totalPrice}}</text></view><view class="item-detail">{{"规格：DN"+item.spec}}</view><view class="item-detail">{{"闸板："+item.gatePlate}}</view><view class="item-detail">{{"阀杆："+item.rodMaterial}}</view><view class="item-detail">{{"类型："+item.productType}}</view><view class="item-detail">{{"数量："+item.quantity}}</view><view class="item-detail">{{"单价：¥"+item.unitPrice}}</view><block wx:if="{{item.brandingFee}}"><view class="item-detail">{{"磨标费：¥"+item.brandingFee}}</view></block><view class="delete-btn" data-index="{{index}}" data-event-opts="{{[['tap',[['onDeleteItem',['$event']]]]]}}" bindtap="__e">删除</view></view></block><view class="total-price"><text class="total-label">总计：</text><text class="total-value">{{"¥"+totalPrice}}</text></view></view></block><block wx:else><block wx:if="{{$root.g2}}"><view class="empty-tip"> 添加阀门后，报价列表将显示在此处 </view></block></block></scroll-view></view>