<view><navigation-bar title="报价表" back="{{true}}" color="white" background="linear-gradient(135deg, #a8a8ea 0%, #0070c0 100%)" data-com-type="wx"></navigation-bar><scroll-view class="scrollarea" scroll-y="{{true}}"><view class="container"><view class="company-header"><view class="company-logo"><text class="logo-text">奇胜阀门有限公司</text></view><view class="company-info"><text class="info-item">http://www.chisun.cn/www.qishengvalve.com</text><text class="info-item">E-mail: qs@chisun.cn</text><text class="info-item">公司地址：浙江省温州市空港新区兴业路8号 邮编：325013</text><text class="info-item">电话: 15777828587</text></view></view><view class="quotation-title">报价单</view><view class="customer-info"><view class="info-row"><text class="info-label">客户名称：</text><input class="info-input" placeholder="请输入客户名称" data-event-opts="{{[['input',[['onCustomerNameInput',['$event']]]]]}}" value="{{customerName}}" bindinput="__e"/></view></view><view class="quotation-table"><view class="table-header"><view class="header-cell cell-product">产品名称</view><view class="header-cell cell-model">型号规格</view><view class="header-cell cell-material">闸板材质</view><view class="header-cell cell-seal">阀杆材质</view><view class="header-cell cell-quantity">数量</view><view class="header-cell cell-price">单价</view><view class="header-cell cell-branding">膜标费</view><view class="header-cell cell-total">总价</view></view><view class="table-body"><block wx:for="{{quoteData}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="table-row"><view class="table-cell cell-product">{{item.productType}}</view><view class="table-cell cell-model">{{item.productName+'-DN'+item.model}}</view><view class="table-cell cell-material">{{item.gateMaterial}}</view><view class="table-cell cell-seal">{{item.stemMaterial}}</view><view class="table-cell cell-quantity">{{item.quantity}}</view><view class="table-cell cell-price">{{item.unitPrice}}</view><view class="table-cell cell-branding">{{item.brandingFee}}</view><view class="table-cell cell-total">{{item.totalPrice}}</view></view></block></view></view><view class="quotation-note"><text class="note-title">备注：</text><textarea class="note-input" placeholder="请输入备注信息" data-event-opts="{{[['input',[['onNoteInput',['$event']]]]]}}" value="{{note}}" bindinput="__e"></textarea></view><view class="payment-packaging"><view class="info-row"><text class="info-label">付款方式：</text><input class="info-input" placeholder="请输入付款方式" data-event-opts="{{[['input',[['onPaymentMethodInput',['$event']]]]]}}" value="{{paymentMethod}}" bindinput="__e"/></view><view class="info-row"><text class="info-label">包装方式：</text><input class="info-input" placeholder="请输入包装方式" data-event-opts="{{[['input',[['onPackagingInput',['$event']]]]]}}" value="{{packaging}}" bindinput="__e"/></view></view><view class="quoter-info"><view class="info-row"><text class="info-label">报价人：</text><input class="info-input short-input" placeholder="请输入报价人" data-event-opts="{{[['input',[['onQuoterInput',['$event']]]]]}}" value="{{quoter}}" bindinput="__e"/></view><view class="info-row"><text class="info-label">手机：</text><input class="info-input short-input" placeholder="请输入手机号码" data-event-opts="{{[['input',[['onQuoterPhoneInput',['$event']]]]]}}" value="{{quoterPhone}}" bindinput="__e"/></view><view class="info-row"><text class="info-label">报价有效期：</text><input class="info-input max-short-input" placeholder="请输入有效期" data-event-opts="{{[['input',[['onValidityInput',['$event']]]]]}}" value="{{validity}}" bindinput="__e"/></view><view class="info-row"><text class="info-label">报价日期：</text><text class="info-value">{{currentDate}}</text></view></view><view class="button-group"><button data-event-opts="{{[['tap',[['generateQuotation',['$event']]]]]}}" class="btn btn-primary" bindtap="__e">生成报价表</button><button class="btn btn-secondary" open-type="share">分享报价表</button><button data-event-opts="{{[['tap',[['onBack',['$event']]]]]}}" class="btn btn-back" bindtap="__e">返回继续添加</button></view></view></scroll-view><canvas style="width:5000rpx;height:5000rpx;position:fixed;left:-9999rpx;" canvas-id="quotationCanvas"></canvas></view>