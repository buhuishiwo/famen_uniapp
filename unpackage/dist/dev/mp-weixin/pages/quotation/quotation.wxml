<view class="page-root"><navigation-bar title="报价表" back="{{true}}" color="white" background="linear-gradient(135deg, #0d1526 0%, #1e293b 100%)" data-com-type="wx"></navigation-bar><scroll-view class="scrollarea" scroll-y="{{true}}"><view class="container"><view class="company-header"><view class="company-logo"><text class="logo-text">奇胜阀门有限公司</text><text class="logo-en">CHISUN VALVE CO., LTD.</text></view><view class="company-info"><text class="info-item">官网：www.chisun.cn / www.qishengvalve.com</text><text class="info-item">邮箱：qs@chisun.cn</text><text class="info-item">地址：浙江省温州市空港新区兴业路8号 邮编：325013</text><text class="info-item">电话：15777828587</text></view></view><view class="quotation-title-wrap"><view class="title-line"></view><text class="quotation-title">报 价 单</text><view class="title-line"></view></view><view class="card"><view class="info-row"><text class="info-label">报价员</text><input class="info-input" placeholder="请输入报价员姓名" placeholder-class="placeholder-style" data-event-opts="{{[['input',[['onSalespersonInput',['$event']]]]]}}" value="{{salesperson}}" bindinput="__e"/></view><view class="divider-line"></view><view class="info-row"><text class="info-label">客户名称</text><input class="info-input" placeholder="请输入客户名称" placeholder-class="placeholder-style" data-event-opts="{{[['input',[['onCustomerNameInput',['$event']]]]]}}" value="{{customerName}}" bindinput="__e"/></view></view><view class="table-card"><scroll-view class="table-scroll" scroll-x="{{true}}"><view class="table-wrap"><view class="table-header"><view class="header-cell cell-product">产品名称</view><view class="header-cell cell-model">型号规格</view><view class="header-cell cell-material">闸板材质</view><view class="header-cell cell-seal">阀杆材质</view><view class="header-cell cell-quantity">数量</view><view class="header-cell cell-price">单价</view><view class="header-cell cell-branding">磨标费</view><view class="header-cell cell-total">总价</view></view><view class="table-body"><block wx:for="{{quoteData}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="{{['table-row',(index%2===1)?'row-odd':'']}}"><view class="table-cell cell-product">{{item.productType}}</view><view class="table-cell cell-model">{{item.productName+'-DN'+item.model}}</view><view class="table-cell cell-material">{{item.gateMaterial}}</view><view class="table-cell cell-seal">{{item.stemMaterial}}</view><view class="table-cell cell-quantity">{{item.quantity}}</view><view class="table-cell cell-price">{{"¥"+item.unitPrice}}</view><view class="table-cell cell-branding">{{"¥"+item.brandingFee}}</view><view class="table-cell cell-total text-total-price">{{"¥"+item.totalPrice}}</view></view></block></view></view></scroll-view></view><view class="card preview-card"><text class="card-inner-title">选购产品信息</text><view class="preview-list"><block wx:for="{{quoteData}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="preview-product"><view class="preview-product-header"><view class="product-index-badge"><text class="product-index-num">{{index+1}}</text></view><text class="product-name">{{item.productName}}</text><block wx:if="{{item.productSeries}}"><view class="product-series-tag"><text>{{item.productSeries}}</text></view></block></view><view class="preview-detail-grid"><view class="detail-cell"><text class="detail-label">规格</text><text class="detail-value">{{"DN"+item.model}}</text></view><view class="detail-cell"><text class="detail-label">产品类型</text><text class="detail-value">{{item.productType}}</text></view><view class="detail-cell"><text class="detail-label">阀体材质</text><text class="detail-value">{{item.bodyMaterial}}</text></view><view class="detail-cell"><text class="detail-label">闸板材质</text><text class="detail-value">{{item.gateMaterial}}</text></view><view class="detail-cell"><text class="detail-label">阀杆材质</text><text class="detail-value">{{item.stemMaterial}}</text></view><block wx:if="{{item.yokeMaterial}}"><view class="detail-cell"><text class="detail-label">支架材质</text><text class="detail-value">{{item.yokeMaterial}}</text></view></block></view><view class="preview-product-footer"><view class="footer-left"><text class="footer-qty">{{"× "+item.quantity+" 件"}}</text><block wx:if="{{item.hasBranding}}"><text class="footer-branding">{{"磨标 ¥"+item.brandingFee+"/件"}}</text></block></view><view class="footer-right"><text class="footer-unit">{{"¥"+item.unitPrice+"/件"}}</text><text class="footer-total">{{"¥"+item.totalPrice}}</text></view></view></view></block></view><view class="preview-summary-bar"><text class="summary-label">合计金额</text><text class="summary-value">{{"¥"+totalAmount}}</text></view><view class="final-price-row"><text class="final-price-label">确认报价金额</text><view class="final-price-input-wrap"><text class="final-price-prefix">¥</text><input class="final-price-input" type="digit" placeholder="请输入最终报价金额" placeholder-class="placeholder-style" data-event-opts="{{[['input',[['onFinalPriceInput',['$event']]]]]}}" value="{{finalPrice}}" bindinput="__e"/></view></view></view><view class="card"><text class="card-inner-title">备注信息</text><view class="textarea-box"><textarea class="note-input" placeholder="请输入备注信息" placeholder-class="placeholder-style" auto-height="{{true}}" maxlength="-1" data-event-opts="{{[['input',[['onNoteInput',['$event']]]]]}}" value="{{note}}" bindinput="__e"></textarea></view></view><view class="card"><view class="info-row"><text class="info-label">付款方式</text><input class="info-input" placeholder="请输入付款方式" placeholder-class="placeholder-style" data-event-opts="{{[['input',[['onPaymentMethodInput',['$event']]]]]}}" value="{{paymentMethod}}" bindinput="__e"/></view><view class="divider-line"></view><view class="info-row"><text class="info-label">包装方式</text><input class="info-input" placeholder="请输入包装方式" placeholder-class="placeholder-style" data-event-opts="{{[['input',[['onPackagingInput',['$event']]]]]}}" value="{{packaging}}" bindinput="__e"/></view></view><view class="card"><view class="info-row"><text class="info-label">报 价 人</text><input class="info-input" placeholder="请输入报价人" placeholder-class="placeholder-style" data-event-opts="{{[['input',[['onQuoterInput',['$event']]]]]}}" value="{{quoter}}" bindinput="__e"/></view><view class="divider-line"></view><view class="info-row"><text class="info-label">联系手机</text><input class="info-input" placeholder="请输入手机号码" placeholder-class="placeholder-style" data-event-opts="{{[['input',[['onQuoterPhoneInput',['$event']]]]]}}" value="{{quoterPhone}}" bindinput="__e"/></view><view class="divider-line"></view><view class="info-row"><text class="info-label">报有效期</text><input class="info-input" placeholder="请输入有效期" placeholder-class="placeholder-style" data-event-opts="{{[['input',[['onValidityInput',['$event']]]]]}}" value="{{validity}}" bindinput="__e"/></view><view class="divider-line"></view><view class="info-row"><text class="info-label">报价日期</text><text class="info-value date-highlight">{{currentDate}}</text></view></view><view class="button-group"><button data-event-opts="{{[['tap',[['generateQuotation',['$event']]]]]}}" class="btn btn-primary" bindtap="__e">生成并保存报价表</button><button class="btn btn-secondary" open-type="share">分享报价表</button><button data-event-opts="{{[['tap',[['onBack',['$event']]]]]}}" class="btn btn-back" bindtap="__e">返回继续添加</button></view></view></scroll-view><canvas style="width:5000rpx;height:5000rpx;position:fixed;left:-9999rpx;" canvas-id="quotationCanvas"></canvas></view>