   工业精工 · 深蓝钢铁
   主色  #0d1526   强调 #c8aa6e
============================ */
.page-root.data-v-689b5506 {
    min-height: 100vh;
    background-color: #eef1f6;
    font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}
.scroll-wrap.data-v-689b5506 {
    height: calc(100vh - 88rpx);
}

/* ---- Hero ---- */
.hero.data-v-689b5506 {
    background: linear-gradient(160deg, #1a2236 0%, #0d1526 70%, #0a1020 100%);
    padding: 40rpx 32rpx 48rpx;
    position: relative;
    overflow: hidden;
}

/* 背景几何装饰 */
.hero.data-v-689b5506::before {
    content: '';
    position: absolute;
    top: -60rpx;
    right: -60rpx;
    width: 320rpx;
    height: 320rpx;
    border-radius: 50%;
    border: 60rpx solid rgba(200,170,110,0.07);
    pointer-events: none;
}
.hero.data-v-689b5506::after {
    content: '';
    position: absolute;
    bottom: -40rpx;
    left: 40rpx;
    width: 200rpx;
    height: 200rpx;
    border-radius: 50%;
    border: 40rpx solid rgba(200,170,110,0.04);
    pointer-events: none;
}
.hero-label.data-v-689b5506 {
    display: flex;
    align-items: center;
    gap: 10rpx;
    margin-bottom: 14rpx;
}
.hero-dot.data-v-689b5506 {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    background: #c8aa6e;
    display: block;
    flex-shrink: 0;
}
.hero-label-text.data-v-689b5506 {
    font-size: 20rpx;
    font-weight: 700;
    color: #c8aa6e;
    letter-spacing: 5rpx;
}
.hero-title.data-v-689b5506 {
    display: block;
    font-size: 48rpx;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.5rpx;
    margin-bottom: 8rpx;
}
.hero-sub.data-v-689b5506 {
    display: block;
    font-size: 24rpx;
    color: rgba(255,255,255,0.45);
    letter-spacing: 1rpx;
    margin-bottom: 32rpx;
}

/* ---- 搜索框 ---- */
.search-wrap.data-v-689b5506 {
    display: flex;
    align-items: center;
    background: rgba(255,255,255,0.09);
    border: 1.5rpx solid rgba(255,255,255,0.14);
    border-radius: 14rpx;
    padding: 0 24rpx;
    height: 80rpx;
    -webkit-backdrop-filter: blur(4px);
            backdrop-filter: blur(4px);
    position: relative;
    z-index: 1;
}
.search-icon-left.data-v-689b5506 {
    font-size: 28rpx;
    margin-right: 16rpx;
    opacity: 0.6;
}
.search-input.data-v-689b5506 {
    flex: 1;
    height: 100%;
    font-size: 28rpx;
    color: #ffffff;
    background: transparent;
    border: none;
    padding: 0;
}
.search-placeholder.data-v-689b5506 {
    color: rgba(255,255,255,0.35);
}
.search-clear.data-v-689b5506 {
    width: 44rpx;
    height: 44rpx;
    border-radius: 50%;
    background: rgba(255,255,255,0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 12rpx;
}
.clear-icon.data-v-689b5506 {
    font-size: 20rpx;
    color: rgba(255,255,255,0.6);
    font-weight: 600;
}

/* ---- 结果计数栏 ---- */
.result-bar.data-v-689b5506 {
    display: flex;
    align-items: center;
    padding: 24rpx 32rpx 8rpx;
    gap: 16rpx;
}
.result-count.data-v-689b5506 {
    font-size: 22rpx;
    font-weight: 700;
    color: #8a97aa;
    letter-spacing: 2rpx;
    white-space: nowrap;
}
.result-line.data-v-689b5506 {
    flex: 1;
    height: 1rpx;
    background: #dde3ed;
}

/* ---- 产品网格 ---- */
.product-grid.data-v-689b5506 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16rpx;
    padding: 16rpx 26rpx 26rpx;
}

/* ---- 产品卡片 ---- */
.product-card.data-v-689b5506 {
    background: #ffffff;
    border-radius: 16rpx;
    padding: 20rpx 16rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 2rpx 12rpx rgba(13, 21, 38, 0.07);
    position: relative;
    overflow: hidden;
    border: 1rpx solid #edf1f8;
    /* 点击态 */
    transition: box-shadow 0.15s;
}
.product-card.data-v-689b5506:active {
    box-shadow: 0 6rpx 24rpx rgba(13, 21, 38, 0.16);
}

/* 序号角标 */
.card-index.data-v-689b5506 {
    position: absolute;
    top: 12rpx;
    left: 12rpx;
    background: #f0f6ff;
    border-radius: 6rpx;
    padding: 2rpx 10rpx;
}
.card-index-text.data-v-689b5506 {
    font-size: 18rpx;
    font-weight: 700;
    color: #4a88c8;
    letter-spacing: 1rpx;
}

/* 图片区 */
.card-image-wrap.data-v-689b5506 {
    width: 260rpx;
    height: 260rpx;
    margin: 20rpx 0 14rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f4f7fb;
    border-radius: 12rpx;
    overflow: hidden;
}
.card-img.data-v-689b5506 {
    width: 250rpx;
    height: 250rpx;
}

/* 卡片底部 */
.card-footer.data-v-689b5506 {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14rpx 8rpx 14rpx;
}
.card-name.data-v-689b5506 {
    font-size: 24rpx;
    font-weight: 700;
    color: #1a2236;
    letter-spacing: 0.5rpx;
}
.card-arrow.data-v-689b5506 {
    font-size: 30rpx;
    color: #b0bac8;
    font-weight: 300;
    line-height: 1;
}

/* 底部金线装饰 */
.card-accent.data-v-689b5506 {
    width: 100%;
    height: 4rpx;
    background: linear-gradient(90deg, #c8aa6e, #e8cc88);
    border-radius: 0 0 2rpx 2rpx;
}

/* ---- 空状态 ---- */
.empty-state.data-v-689b5506 {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 100rpx 0 60rpx;
    gap: 16rpx;
}
.empty-icon.data-v-689b5506 { font-size: 80rpx;
}
.empty-text.data-v-689b5506 {
    font-size: 30rpx;
    font-weight: 600;
    color: #8a97aa;
}
.empty-sub.data-v-689b5506 {
    font-size: 24rpx;
    color: #b0bac8;
    text-align: center;
}

/* ---- 底部安全 ---- */
.bottom-safe.data-v-689b5506 { height: 60rpx;
}

