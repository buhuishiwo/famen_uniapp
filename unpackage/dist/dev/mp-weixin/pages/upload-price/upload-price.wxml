r-radius:12rpx;padding:20rpx;margin-bottom:12rpx;"><view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6rpx;"><text style="font-size:26rpx;font-weight:600;color:#0d1526;">{{row.materialCode}}</text><text style="font-size:20rpx;padding:4rpx 12rpx;border-radius:20rpx;background:#e2e8f0;color:#64748b;">{{''+row.category+''}}</text></view><view style="display:flex;flex-direction:column;gap:8rpx;font-size:22rpx;"><view style="display:flex;gap:16rpx;"><text style="color:#64748b;width:100rpx;">名称:</text><text style="color:#0d1526;font-weight:600;">{{row.materialName}}</text></view><view style="display:flex;gap:16rpx;"><text style="color:#64748b;width:100rpx;">适用:</text><text style="color:#0d1526;font-weight:600;">{{row.applicableParts}}</text></view><block wx:if="{{row.remark}}"><view style="display:flex;gap:16rpx;"><text style="color:#64748b;width:100rpx;">备注:</text><text style="color:#64748b;">{{row.remark}}</text></view></block></view></view></block></view></block><block wx:else><view class="material-list"><block wx:for="{{previewData}}" wx:for-item="row" wx:for-index="index" wx:key="index"><view class="material-item" style="background:#f8fafc;border-radius:12rpx;padding:20rpx;margin-bottom:12rpx;"><view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6rpx;"><text style="font-size:26rpx;font-weight:600;color:#0d1526;">{{row.valveName}}</text><text style="font-size:20rpx;padding:4rpx 12rpx;border-radius:20rpx;background:#e2e8f0;color:#64748b;">{{''+(row.remark||'无备注')+''}}</text></view><view style="display:flex;flex-direction:column;gap:8rpx;font-size:22rpx;"><view style="display:flex;gap:16rpx;"><text style="color:#64748b;width:100rpx;">阀体:</text><text style="color:#0d1526;font-weight:600;">{{row.bodyMaterial}}</text></view><view style="display:flex;gap:16rpx;"><text style="color:#64748b;width:100rpx;">闸板:</text><text style="color:#0d1526;font-weight:600;">{{row.gatePlateMaterial}}</text></view><vie