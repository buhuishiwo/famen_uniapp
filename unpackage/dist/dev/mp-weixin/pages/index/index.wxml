<view><navigation-bar title="{{currentProductSeries||'阀门选择'}}" back="{{true}}" color="white" background="linear-gradient(135deg, #1a2236 0%, #0d1526 100%);" data-event-opts="{{[['back',[['onBackToCategory',['$event']]]]]}}" data-com-type="wx" bindback="__e"></navigation-bar><scroll-view class="scroll-content" scroll-y="{{true}}"><view class="page-header"><view class="header-badge"><text class="badge-dot"></text><text class="badge-text">配置报价</text></view><text class="page-title">{{currentProductSeries||'阀门选择'}}</text><text class="page-subtitle">请依次选择以下参数生成报价</text></view><view class="form-section"><view class="form-section-label"><text class="section-icon">⚙</text><text class="section-name">产品配置</text></view><view class="form-item"><text class="label">阀门型号</text><picker class="picker" mode="selector" range="{{valveTypes}}" range-key="name" data-event-opts="{{[['change',[['onSelectValve',['$event']]]]]}}" bindchange="__e"><view class="{{['picker-box',(selectedValve)?'filled':'']}}"><text class="picker-text">{{selectedValve?selectedValve.name:'请选择阀门型号'}}</text><text class="picker-arrow">›</text></view></picker></view><view class="form-divider"></view><view class="form-item"><text class="label">规格尺寸 (DN)</text><picker class="picker" mode="selector" range="{{specifications}}" range-key="name" data-event-opts="{{[['change',[['onSelectSpec',['$event']]]]]}}" bindchange="__e"><view class="{{['picker-box',(selectedSpec)?'filled':'']}}"><text class="picker-text">{{selectedSpec?selectedSpec.name:'请选择规格尺寸'}}</text><text class="picker-arrow">›</text></view></picker></view><view class="form-divider"></view><view class="form-item"><text class="label">阀体材质</text><picker class="picker" mode="selector" range="{{valveBodyTypes}}" range-key="name" data-event-opts="{{[['change',[['onSelectValveBody',['$event']]]]]}}" bindchange="__e"><view class="{{['picker-box',(SelectValveBody)?'filled':'']}}"><text class="picker-text">{{SelectValveBody?SelectValveBody.name:'请选择阀体材质'}}</text><text class="picker-arrow">›</text></view></picker></view><view class="form-divider"></view><view class="form-item"><text class="label">闸板材质</text><picker class="picker" mode="selector" range="{{gatePlateTypes}}" range-key="name" data-event-opts="{{[['change',[['onSelectGatePlate',['$event']]]]]}}" bindchange="__e"><view class="{{['picker-box',(selectedGatePlate)?'filled':'']}}"><text class="picker-text">{{selectedGatePlate?selectedGatePlate.name:'请选择闸板材质'}}</text><text class="picker-arrow">›</text></view></picker></view><view class="form-divider"></view><view class="form-item"><text class="label">阀杆材质</text><picker class="picker" mode="selector" range="{{rodMaterials}}" range-key="name" data-event-opts="{{[['change',[['onSelectRodMaterial',['$event']]]]]}}" bindchange="__e"><view class="{{['picker-box',(selectedRodMaterial)?'filled':'']}}"><text class="picker-text">{{selectedRodMaterial?selectedRodMaterial.name:'请选择阀杆材质'}}</text><text class="picker-arrow">›</text></view></picker></view><view class="form-divider"></view><view class="form-item"><text class="label">产品类型</text><picker class="picker" mode="selector" range="{{productTypeOptions}}" data-event-opts="{{[['change',[['onSelectProductType',['$event']]]]]}}" bindchange="__e"><view class="picker-box filled"><text class="picker-text">{{selectedProductType}}</text><text class="picker-arrow">›</text></view></picker></view><view class="form-divider"></view><view class="form-item"><text class="label">数量</text><view class="qty-wrapper"><input class="qty-input" type="number" placeholder="请输入数量" placeholder-class="qty-placeholder" data-event-opts="{{[['input',[['onQuantityChange',['$event']]]]]}}" value="{{quantity}}" bindinput="__e"/></view></view><view class="form-divider"></view><view class="form-item"><text class="label">磨商标</text><view class="toggle-group"><view data-event-opts="{{[['tap',[['onSelectBranding',[true]]]]]}}" class="{{['toggle-item',(selectedBranding===true)?'active':'']}}" bindtap="__e"><block wx:if="{{selectedBranding===true}}"><text class="toggle-dot">●</text></block><block wx:else><text class="toggle-dot-off">○</text></block><text>是</text></view><view data-event-opts="{{[['tap',[['onSelectBranding',[false]]]]]}}" class="{{['toggle-item',(selectedBranding===false)?'active':'']}}" bindtap="__e"><block wx:if="{{selectedBranding===false}}"><text class="toggle-dot">●</text></block><block wx:else><text class="toggle-dot-off">○</text></block><text>否</text></view></view></view><block wx:if="{{selectedValve&&selectedSpec&&selectedGatePlate&&selectedRodMaterial}}"><view class="price-card"><view class="price-row"><view class="price-col"><text class="price-tag">单　价</text><text class="price-amount">¥<text class="price-num">{{currentPrice}}</text></text></view><view class="price-divider-v"></view><view class="price-col"><text class="price-tag">预估总价</text><text class="price-amount total-highlight">¥<text class="price-num">{{totalPreviewPrice}}</text></text></view></view></view></block></view><view class="action-area"><button data-event-opts="{{[['tap',[['onAddToQuote',['$event']]]]]}}" class="btn btn-add" bindtap="__e"><text class="btn-icon">＋</text><text>添加到报价表</text></button><block wx:if="{{$root.g0>0}}"><button data-event-opts="{{[['tap',[['onGenerateQuotation',['$event']]]]]}}" class="btn btn-generate" bindtap="__e"><text class="btn-icon">📋</text><text>生成报价表</text></button></block></view><block wx:if="{{$root.g1>0}}"><view class="quote-list"><view class="list-header"><text class="list-title">📦 报价明细</text><view class="list-count-badge"><text class="list-count">{{$root.g2+" 项"}}</text></view></view><block wx:for="{{quoteItems}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="quote-item"><view class="quote-item-header"><view class="item-index-badge"><text>{{index+1}}</text></view><text class="item-valve-name">{{item.valveName}}</text><view class="delete-btn" data-index="{{index}}" data-event-opts="{{[['tap',[['onDeleteItem',['$event']]]]]}}" bindtap="__e"><text>✕</text></view></view><view class="item-tags"><view class="tag">{{"DN"+item.spec}}</view><view class="tag">{{item.gatePlate}}</view><view class="tag">{{item.rodMaterial}}</view><view class="tag tag-type">{{item.productType}}</view></view><view class="item-price-row"><view class="item-meta"><text class="meta-item">{{"× "+item.quantity+" 件"}}</text><block wx:if="{{item.brandingFee}}"><text class="meta-item">{{"磨标 ¥"+item.brandingFee+"/件"}}</text></block></view><view class="item-price-right"><text class="unit-price">{{"¥"+item.unitPrice+"/件"}}</text><text class="total-item-price">{{"¥"+item.totalPrice}}</text></view></view></view></block><view class="quote-total-bar"><text class="total-bar-label">合计金额</text><text class="total-bar-value">{{"¥"+totalPrice}}</text></view></view></block><block wx:else><block wx:if="{{$root.g3}}"><view class="empty-state"><text class="empty-icon">📝</text><text class="empty-text">暂无报价项目</text><text class="empty-sub">配置好参数后点击「添加到报价表」</text></view></block></block><view class="bottom-safe"></view></scroll-view></view>